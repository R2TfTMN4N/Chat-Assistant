# packages/backend/.env.example — server-only variables (no secrets)

# OpenAI / AI
OPENAI_API_KEY=

# Clerk (server)
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWT_ISSUER_DOMAIN=

# Convex
CONVEX_DEPLOYMENT=

# AWS (if used)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Svix
SVIX_SECRET=

# Sentry (optional)
SENTRY_DSN=

# Notes:
# - Copy this to packages/backend/.env.local and fill values. Keep .env.local out of git.