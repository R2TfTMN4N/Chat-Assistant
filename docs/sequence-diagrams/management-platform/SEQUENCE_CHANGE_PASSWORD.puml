@startuml Sequence Diagram - Change Password

actor "User" as User
participant "AccountSettingsView" as SettingsView
participant "ClerkAuth" as ClerkAuth
participant "Backend" as Backend

User -> SettingsView : 1 Open account settings page
activate SettingsView
SettingsView -> SettingsView : 2 Display change password form

User -> SettingsView : 3 Enter current password
User -> SettingsView : 4 Enter new password
User -> SettingsView : 5 Click "Change Password" button

SettingsView -> SettingsView : 6 Validate input format

alt [Invalid input]
    SettingsView -> SettingsView : 7 Error notification
    SettingsView -> User : 8 Display error notification
else [Valid input]
    SettingsView -> ClerkAuth : 9 Send change password request
    activate ClerkAuth

    ClerkAuth -> ClerkAuth : 10 Verify current password

    alt [Incorrect current password]
        ClerkAuth -> SettingsView : 11 Error notification
        SettingsView -> SettingsView : 12 Error notification
        SettingsView -> User : 13 Display error notification
    else [Correct password]
        ClerkAuth -> ClerkAuth : 14 Update password
        ClerkAuth -> Backend : 15 Invalidate old sessions
        activate Backend
        Backend -> Backend : 16 Invalidate sessions
        Backend -> ClerkAuth : 17 Confirmation
        deactivate Backend

        ClerkAuth -> SettingsView : 18 Success notification
        SettingsView -> User : 19 Display success message
    end
    deactivate ClerkAuth
end

deactivate SettingsView

@enduml
