@startuml Sequence Diagram - Mark as Resolved

actor "TeamMember" as TeamMember
participant "ConversationDetailView" as ConvDetailView
participant "ClerkAuth" as ClerkAuth
participant "Backend" as Backend

TeamMember -> ConvDetailView : 1 Open conversation detail page
activate ConvDetailView
ConvDetailView -> ConvDetailView : 2 Display resolve option

TeamMember -> ConvDetailView : 3 Click "Mark as Resolved" button
ConvDetailView -> ClerkAuth : 4 Send resolve request
activate ClerkAuth
ClerkAuth -> Backend : 5 Update conversation status
activate Backend
Backend -> Backend : 6 Update conversation record
Backend -> ClerkAuth : 7 Confirmation
ClerkAuth -> ConvDetailView : 8 Success notification
ConvDetailView -> TeamMember : 9 Display success message

deactivate Backend
deactivate ClerkAuth
deactivate ConvDetailView

@enduml
