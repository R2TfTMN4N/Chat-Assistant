@startuml Sequence Diagram - Set Phone Number

actor "Admin" as Admin
participant "PhoneNumberView" as PhoneView
participant "ClerkAuth" as ClerkAuth
participant "Backend" as Backend

Admin -> PhoneView : 1 Open phone number configuration page
activate PhoneView
PhoneView -> PhoneView : 2 Display phone number form

Admin -> PhoneView : 3 Edit phone number
Admin -> PhoneView : 4 Click "Save" button

PhoneView -> PhoneView : 5 Validate input format

alt [Invalid input]
    PhoneView -> PhoneView : 6 Error notification
    PhoneView -> Admin : 7 Display error notification
else [Valid input]
    PhoneView -> ClerkAuth : 8 Send update request
    activate ClerkAuth
    ClerkAuth -> Backend : 9 Update phone number
    activate Backend
    Backend -> Backend : 10 Store phone number
    Backend -> ClerkAuth : 11 Confirmation
    deactivate Backend
    ClerkAuth -> PhoneView : 12 Success notification
    PhoneView -> Admin : 13 Display success message
    deactivate ClerkAuth
end

deactivate PhoneView

@enduml
