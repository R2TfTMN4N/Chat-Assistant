@startuml Sequence Diagram - Search Conversations

actor "TeamMember" as TeamMember
participant "ConversationListView" as ConvListView
participant "ClerkAuth" as ClerkAuth
participant "Backend" as Backend

TeamMember -> ConvListView : 1 Open conversations page
activate ConvListView
ConvListView -> ConvListView : 2 Display search bar

TeamMember -> ConvListView : 3 Enter search query
ConvListView -> ClerkAuth : 4 Request search results
activate ClerkAuth
ClerkAuth -> Backend : 5 Search conversations
activate Backend
Backend -> Backend : 6 Retrieve search results
Backend -> ClerkAuth : 7 Return search data
ClerkAuth -> ConvListView : 8 Return search info
ConvListView -> TeamMember : 9 Display search results

deactivate Backend
deactivate ClerkAuth
deactivate ConvListView

@enduml
