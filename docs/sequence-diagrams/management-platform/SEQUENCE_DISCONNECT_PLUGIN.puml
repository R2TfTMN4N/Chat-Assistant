@startuml Sequence Diagram - Disconnect Plugin

actor "Admin" as Admin
participant "PluginView" as PluginView
participant "ClerkAuth" as ClerkAuth
participant "Backend" as Backend

Admin -> PluginView : 1 Open plugins page
activate PluginView
PluginView -> PluginView : 2 Display connected plugins

Admin -> PluginView : 3 Select plugin to disconnect
Admin -> PluginView : 4 Click "Disconnect" button

PluginView -> ClerkAuth : 5 Send disconnect request
activate ClerkAuth
ClerkAuth -> Backend : 6 Disconnect plugin
activate Backend
Backend -> Backend : 7 Update plugin records
Backend -> ClerkAuth : 8 Confirmation
ClerkAuth -> PluginView : 9 Success notification
PluginView -> Admin : 10 Display success message

deactivate Backend
deactivate ClerkAuth
deactivate PluginView

@enduml
