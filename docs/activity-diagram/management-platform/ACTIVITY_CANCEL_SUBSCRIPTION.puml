@startuml Activity Diagram - Cancel Subscription

skinparam dpi 150
skinparam activityPadding 6
skinparam activityMargin 6
skinparam arrowThickness 1
skinparam notePadding 4
skinparam shadowing false
skinparam defaultFontSize 11

|User|
start

|System|
:(1) Display subscription view;

repeat
  |User|
  :(2) Click "Cancel Subscription";

  |System|
  :(3) Show confirmation dialog;
  if (Confirmed?) then (No)
    :(3.1) Cancel and return to subscription view;
  else (Yes)
    |Database|
    :(4) Check subscription status;
    if (Active?) then (Not active)
      |System|
      :(4.1) Display error notification;
    else (Active)
      |Database|
      :(5) Update subscription to cancelled;
      if (Update failed?) then (Error)
        |System|
        :(5.1) Display error notification;
      else (Success)
        |System|
        :(6) Display success notification, update UI;
        stop
      endif
    endif
  endif
repeat while (Not active or Error)

@enduml