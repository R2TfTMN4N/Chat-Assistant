@startuml Activity Diagram - Sign Up

skinparam dpi 150
skinparam activityPadding 6
skinparam activityMargin 6
skinparam arrowThickness 1
skinparam notePadding 4
skinparam shadowing false
skinparam defaultFontSize 11

|User|
start

|System|
:(1) Display sign up view;

repeat
  |User|
  :(2) Enter username, email and password;
  :(3) Click "Sign Up";

  |System|
  :(4) Validate data;
  if (Data valid?) then (Invalid data)
    :(4.1) Display error notification;
  else (Valid data)
    |Database|
    :(5) Check email uniqueness;
    if (Email exists?) then (Email exists)
      |System|
      :(5.1) Display error notification;
    else (Unique)
      |Database|
      :(6) Create account;
      |System|
      :(7) Display success and redirect to HomeView;
      stop
    endif
  endif
repeat while (Invalid data or Email exists)

@enduml