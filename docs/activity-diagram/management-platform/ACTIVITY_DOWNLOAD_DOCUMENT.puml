@startuml Activity Diagram - Download Document

skinparam dpi 150
skinparam activityPadding 6
skinparam activityMargin 6
skinparam arrowThickness 1
skinparam notePadding 4
skinparam shadowing false
skinparam defaultFontSize 11

|User|
start

|System|
:(1) Open Knowledge / Documents view;

|User|
:(2) Select document;
:(3) Click "Download";

|System|
:(4) Check permissions;
if (Allowed?) then (Yes)
  |Database|
  :(5) Fetch document;
  |System|
  :(6) Return file for download; 
  stop
else (No)
  |System|
  :(4.1) Show "Access denied"; 
  stop
endif

@enduml
