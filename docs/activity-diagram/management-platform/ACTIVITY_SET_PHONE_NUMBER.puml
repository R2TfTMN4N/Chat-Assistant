@startuml Activity Diagram - Set Phone Number

skinparam dpi 150
skinparam activityPadding 6
skinparam activityMargin 6
skinparam arrowThickness 1
skinparam notePadding 4
skinparam shadowing false
skinparam defaultFontSize 11

|User|
start

|System|
:(1) Display phone number settings view;

repeat
  |User|
  :(2) Enter phone number;
  :(3) Click "Save";

  |System|
  :(4) Validate phone format;
  if (Valid?) then (Invalid)
    :(4.1) Display error;
  else (Valid)
    |Database|
    :(5) Store phone number;
    if (Store failed?) then (Error)
      |System|
      :(5.1) Display error;
    else (Success)
      |System|
      :(6) Display success;
      stop
    endif
  endif
repeat while (Invalid or Error)

@enduml