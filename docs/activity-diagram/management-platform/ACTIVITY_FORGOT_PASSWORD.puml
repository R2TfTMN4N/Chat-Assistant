@startuml Activity Diagram - Forgot Password

skinparam dpi 150
skinparam activityPadding 6
skinparam activityMargin 6
skinparam arrowThickness 1
skinparam notePadding 4
skinparam shadowing false
skinparam defaultFontSize 11

|User|
start

|System|
:(1) Display forgot password view;

repeat
  |User|
  :(2) Enter email address;
  :(3) Click "Send Reset Link";

  |System|
  :(4) Validate email;
  if (Email valid?) then (Invalid email)
    :(4.1) Display error notification;
  else (Valid email)
    |Database|
    :(5) Check email exists;
    if (Email exists?) then (Not found)
      |System|
      :(5.1) Display error notification;
    else (Found)
      |System|
      :(6) Send reset link and display notification;
      stop
    endif
  endif
repeat while (Invalid email or Not found)

@enduml
