@startuml Activity Diagram - View Current Plan

skinparam dpi 150
skinparam activityPadding 6
skinparam activityMargin 6
skinparam arrowThickness 1
skinparam notePadding 4
skinparam shadowing false
skinparam defaultFontSize 11

|User|
start

|System|
:(1) Display subscription summary view;

|User|
:(2) Click "View Current Plan";

|System|
:(3) Request current plan details;
|Database|
:(4) Query current subscription;
if (Subscription found?) then (Not found)
  |System|
  :(4.1) Display "No active subscription" message;
else (Found)
  |System|
  :(5) Display current plan details;
  stop
endif

@enduml