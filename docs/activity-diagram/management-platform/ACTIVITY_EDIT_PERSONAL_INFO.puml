@startuml Activity Diagram - Edit Personal Information

' Simple: System shows view → User edits → System validates → Database stores → loop on error
skinparam dpi 150
skinparam activityPadding 6
skinparam activityMargin 6
skinparam arrowThickness 1
skinparam notePadding 4
skinparam shadowing false
skinparam defaultFontSize 11

|User|
start

|System|
:(1) Display personal information view;

repeat
  |User|
  :(2) Edit personal information;
  :(3) Click "Save";

  |System|
  :(4) Validate data;
  if (Data valid?) then (Invalid data)
    :(4.1) Display error notification;
  else (Valid data)
    |Database|
    :(5) Store updated data;
    if (Store failed?) then (Error)
      |System|
      :(5.1) Display error notification;
    else (Success)
      |System|
      :(6) Display success and refresh view;
      stop
    endif
  endif
repeat while (Invalid data)

@enduml