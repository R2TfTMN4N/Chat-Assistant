@startuml Activity Diagram - Change Password

skinparam dpi 150
skinparam activityPadding 6
skinparam activityMargin 6
skinparam arrowThickness 1
skinparam notePadding 4
skinparam shadowing false
skinparam defaultFontSize 11

|User|
start

|System|
:(1) Display change password view;

repeat
  |User|
  :(2) Enter current password and new password;
  :(3) Click "Change Password";

  |System|
  :(4) Validate data;
  if (Data valid?) then (Invalid data)
    :(4.1) Display error notification;
  else (Valid data)
    |Database|
    :(5) Validate current password;
    if (Current valid?) then (Invalid current)
      |System|
      :(5.1) Display error notification;
    else (Current valid)
      |Database|
      :(6) Store new password;
      if (Store failed?) then (Error)
        |System|
        :(6.1) Display error notification;
      else (Success)
        |System|
        :(7) Display success notification;
        stop
      endif
    endif
  endif
repeat while (Invalid data or Invalid current or Error)

@enduml