@startuml Activity Diagram - View Message History

skinparam dpi 150
skinparam activityPadding 6
skinparam activityMargin 6
skinparam arrowThickness 1
skinparam notePadding 4
skinparam shadowing false
skinparam defaultFontSize 11

|User|
start

|System|
:(1) Open Conversation detail view;

|User|
:(2) Click "View messages";

|System|
:(3) Send authenticated request for message history;
|Database|
:(4) Query message records;
if (Found?) then (Yes)
  |System|
  :(5) Return message data;
  :(6) Display message history; 
  stop
else (No)
  |System|
  :(4.1) Show "No messages" or error; 
  stop
endif

@enduml