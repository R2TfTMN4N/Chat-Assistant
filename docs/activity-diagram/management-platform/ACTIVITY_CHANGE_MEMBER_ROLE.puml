@startuml Activity Diagram - Change Team Member Role

skinparam dpi 150
skinparam activityPadding 6
skinparam activityMargin 6
skinparam arrowThickness 1
skinparam notePadding 4
skinparam shadowing false
skinparam defaultFontSize 11

|User|
start

|System|
:(1) Display team members view;

repeat
  |User|
  :(2) Select member and choose new role;
  :(3) Click "Change Role";

  |System|
  :(4) Validate role and permissions;
  if (Valid?) then (Invalid)
    :(4.1) Display error notification;
  else (Valid)
    |Database|
    :(5) Update member role;
    if (Update failed?) then (Error)
      |System|
      :(5.1) Display error notification;
    else (Success)
      |System|
      :(6) Display success notification and refresh list;
      stop
    endif
  endif
repeat while (Invalid or Error)

@enduml