@startuml Activity Diagram - Enable/Disable Voice Calls

skinparam dpi 150
skinparam activityPadding 6
skinparam activityMargin 6
skinparam arrowThickness 1
skinparam notePadding 4
skinparam shadowing false
skinparam defaultFontSize 11

|User|
start

|System|
:(1) Display voice call settings view;

repeat
  |User|
  :(2) Toggle "Enable Voice Calls";
  :(3) Click "Save";

  |System|
  :(4) Validate setting;
  if (Valid?) then (Invalid)
    :(4.1) Display error;
  else (Valid)
    |Database|
    :(5) Store voice call setting;
    if (Store failed?) then (Error)
      |System|
      :(5.1) Display error;
    else (Success)
      |System|
      :(6) Apply setting and display success;
      stop
    endif
  endif
repeat while (Invalid or Error)

@enduml