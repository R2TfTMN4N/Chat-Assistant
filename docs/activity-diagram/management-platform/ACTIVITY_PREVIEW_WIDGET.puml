@startuml Activity Diagram - Preview Widget

skinparam dpi 150
skinparam activityPadding 6
skinparam activityMargin 6
skinparam arrowThickness 1
skinparam notePadding 4
skinparam shadowing false
skinparam defaultFontSize 11

|User|
start

|System|
:(1) Display widget preview view;

|User|
:(2) Click "Preview";

|System|
:(3) Request widget settings;
|Database|
:(4) Query settings;
if (Settings found?) then (Not found)
  |System|
  :(4.1) Display error;
else (Found)
  |System|
  :(5) Display widget preview;
  stop
endif

@enduml