@startuml Activity Diagram - Update API Credentials

skinparam dpi 150
skinparam activityPadding 6
skinparam activityMargin 6
skinparam arrowThickness 1
skinparam notePadding 4
skinparam shadowing false
skinparam defaultFontSize 11

|User|
start

|System|
:(1) Open API / Credentials settings;
:(2) Display current credentials (obscured);

|User|
:(3) Click "Update Credentials";
:(4) Enter new API key/secret and click "Save";

|System|
:(5) Validate credentials (syntax & optional test call);
if (Valid?) then (Yes)
  |Database|
  :(6) Store encrypted credentials;
  |System|
  :(7) Show success;
  stop
else (No)
  |System|
  :(5.1) Show error and allow retry;
  stop
endif

@enduml
