@startuml Activity Diagram - Delete Document

skinparam dpi 150
skinparam activityPadding 6
skinparam activityMargin 6
skinparam arrowThickness 1
skinparam notePadding 4
skinparam shadowing false
skinparam defaultFontSize 11

|User|
start

|System|
:(1) Open Knowledge / Documents view;

|User|
:(2) Select document;
:(3) Click "Delete";

|System|
:(4) Show confirmation dialog;

|User|
:(5) Confirm delete;

|System|
:(6) Send request to delete document;
|Database|
:(7) Delete document record;
if (Deleted?) then (Yes)
  |System|
  :(8) Show "Deleted" and refresh list;
  stop
else (No)
  |System|
  :(7.1) Show error and allow retry;
  stop
endif

@enduml