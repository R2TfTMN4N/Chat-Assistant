@startuml Activity Diagram - Click Suggested Question

skinparam dpi 150
skinparam activityPadding 6
skinparam activityMargin 6
skinparam arrowThickness 1
skinparam notePadding 4
skinparam shadowing false
skinparam defaultFontSize 11

|Customer|
start
|System|
:(1) Open chat widget;

|Customer|
:(2) Click suggested question;

|System|
:(3) Insert suggestion into input;
:(4) Send question request;

|Database|
:(5) Store/update conversation;

|System|
:(6) Display confirmation / update chat;
stop

@enduml