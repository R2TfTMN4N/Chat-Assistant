# Root .env.example — list of environment variables used across the repo

# Convex
CONVEX_DEPLOYMENT=

# Clerk (auth)
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWT_ISSUER_DOMAIN=
NEXT_PUBLIC_CLERK_FRONTEND_API=

# OpenAI / AI
OPENAI_API_KEY=
GOOGLE_API_KEY=

# AWS (if used)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Svix (webhooks)
SVIX_SECRET=

# Sentry (optional)
SENTRY_DSN=

# Next/Deployment (optional)
VERCEL_PROJECT_PRODUCTION_URL=
VERCEL_URL=
VERCEL_BRANCH_URL=

# Notes:
# - Do NOT commit actual secret values. Use .env.local per environment and add it to .gitignore.
# - Add any provider-specific vars to the appropriate package-level .env.example (e.g. packages/backend/.env.example).